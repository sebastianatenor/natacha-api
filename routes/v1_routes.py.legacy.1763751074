from fastapi import APIRouter, Body, HTTPException, Query
from typing import Optional, List, Any
from datetime import datetime, timezone

# Memory v1 usa el mismo helper que antes
from routes.memory_routes import get_db as _get_db

# Tasks v1 va directo a Firestore usando el helper general
from routes.db_util import get_client

router = APIRouter(prefix="/v1", tags=["v1"])


# ============================================================
# ===============        MEMORY  v1        ====================
# ============================================================

@router.post("/memory/add")
def v1_memory_add(payload: dict = Body(...)):
    db = _get_db()
    summary = (payload.get("summary") or "").strip()
    if not summary:
        raise HTTPException(status_code=400, detail="summary is required")

    doc = {
        "summary": summary,
        "detail": payload.get("detail", ""),
        "channel": payload.get("channel", "unknown"),
        "project": payload.get("project", "general"),
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "state": payload.get("state", "vigente"),
        "visibility": payload.get("visibility", "equipo"),
        "created_by": payload.get("created_by", "api.v1.memory.add"),
        "source_links": payload.get("source_links")
            or payload.get("links")
            or [],
    }
    if isinstance(doc["source_links"], str):
        doc["source_links"] = [doc["source_links"]]

    db.collection("assistant_memory").add(doc)

    return {"status": "ok", "data": doc}


@router.get("/memory/search")
def v1_memory_search(
    project: Optional[str] = Query(default=None),
    channel: Optional[str] = Query(default=None),
    query: Optional[str] = Query(default=None),
    limit: int = Query(default=20, le=100),
):
    db = _get_db()
    col = db.collection("assistant_memory")

    # 👉 Sin order_by cuando hay filtros -> NO requiere índices compuestos
    if project or channel:
        q = col
        if project:
            q = q.where("project", "==", project)
        if channel:
            q = q.where("channel", "==", channel)
        docs = q.limit(200).stream()
    else:
        # sin filtros: aceptamos order_by por timestamp (suele existir índice single-field)
        docs = col.order_by("timestamp", direction=1).limit(200).stream()

    results: List[Any] = []
    for d in docs:
        data = d.to_dict()
        data["id"] = d.id
        results.append(data)

    if query:
        ql = query.lower()
        results = [
            it
            for it in results
            if ql in ((it.get("summary") or "") + " " + (it.get("detail") or "")).lower()
        ]

    return {"status": "ok", "count": len(results[:limit]), "items": results[:limit]}


# ============================================================
# ===============         TASKS  v1        ====================
# ============================================================

TASKS_COLLECTION = "assistant_tasks"


def _tasks_col():
    client = get_client()
    return client.collection(TASKS_COLLECTION)


@router.post("/tasks/add")
def v1_tasks_add(payload: dict = Body(...)):
    """
    LEGACY /v1/tasks/add – versión estable y simple.
    Crea una tarea en assistant_tasks.
    """
    title = (payload.get("title") or "").strip()
    if not title:
        raise HTTPException(status_code=400, detail="title is required")

    user_id = (payload.get("user_id") or "sebastian").strip() or "sebastian"
    project = (payload.get("project") or "general").strip() or "general"
    channel = (payload.get("channel") or "chatgpt").strip() or "chatgpt"

    now_iso = datetime.now(timezone.utc).isoformat()

    data = {
        "user_id": user_id,
        "title": title,
        "detail": payload.get("detail", ""),
        "project": project,
        "channel": channel,
        "due": payload.get("due") or "",
        "state": payload.get("state") or "pending",
        "evidence": payload.get("evidence") or [],
        "created_at": now_iso,
        "updated_at": now_iso,
        "created_by": payload.get("created_by", "api.v1.tasks.add"),
    }

    col = _tasks_col()
    doc_ref = col.document()
    doc_ref.set(data)
    data["id"] = doc_ref.id

    return {"status": "ok", "item": data}


@router.get("/tasks/search")
def v1_tasks_search(
    project: Optional[str] = Query(default=None),
    state: Optional[str] = Query(default=None),
    user_id: Optional[str] = Query(default=None),
    limit: int = Query(default=50, ge=1, le=200),
):
    """
    LEGACY /v1/tasks/search – lista tareas filtrando por proyecto/estado/user.
    """
    col = _tasks_col()
    q = col

    if user_id:
        q = q.where("user_id", "==", user_id)
    if project:
        q = q.where("project", "==", project)
    if state:
        q = q.where("state", "==", state)

    try:
        from google.cloud import firestore  # type: ignore

        q = q.order_by("created_at", direction=firestore.Query.DESCENDING)
    except Exception:
        # si no se puede ordenar, igual devolvemos algo
        pass

    docs = q.limit(limit).stream()

    items: List[Any] = []
    for d in docs:
        data = d.to_dict()
        data["id"] = d.id
        items.append(data)

    return {"status": "ok", "count": len(items), "items": items}


@router.post("/tasks/update")
def v1_tasks_update(payload: dict = Body(...)):
    """
    LEGACY /v1/tasks/update – actualiza campos básicos de una tarea.
    """
    task_id = (payload.get("id") or "").strip()
    if not task_id:
        raise HTTPException(status_code=400, detail="id is required")

    col = _tasks_col()
    doc_ref = col.document(task_id)
    snap = doc_ref.get()

    if not snap.exists:
        raise HTTPException(status_code=404, detail="task not found")

    update_data = {}
    for field in ("title", "detail", "state", "due"):
        if field in payload and payload[field] is not None:
            update_data[field] = payload[field]

    update_data["updated_at"] = datetime.now(timezone.utc).isoformat()

    if update_data:
        doc_ref.update(update_data)

    new = doc_ref.get().to_dict()
    new["id"] = task_id

    return {"status": "ok", "item": new}
